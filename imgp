# Uncomment the below line to lift pixel limit for _trusted_ input files
# Image.MAX_IMAGE_PIXELS = None

if not hasattr(PIL.Image, 'Resampling'):  # Pillow<9.0
    PIL.Image.Resampling = PIL.Image

# Globals
HRES = 0  # specified horizontal resolution
VRES = 0  # specified vertical resolution
megapixel = None  # specified megapixel target
scale = None  # specified scale in percentage
rotate = None  # specified rotation in degree
adapt = False  # use adaptive resolution
convert = False  # convert PNG to JPG
hidden = False  # process hidden files
eraseexif = False  # erase EXIF metadata
progressive = False  # save as a progressive image
force = False  # forced to exact specified resolution
includeimgp = False  # process _IMGP files
keep = False  # ignore images with matching hres or vres
minH = 0  # min horizontal resolution to convert
minV = 0  # min vertical resolution to convert
enlarge = False  # enlarge images with smaller hres or vres
optimal = False  # apply PIL library optimization when saving
mute = False  # suppress additional information
recurse = False  # recursively process subdirectories
size = 1024  # min byte size to process an image
qual = 75  # the default value of quality factor
overwrite = False  # remove source images
debug = False  # enable debug information
no_res_opt = False  # --res is not specified
pad = '_IMGP'  # output file suffix when --overwrite is unused
png_ip = Image.Resampling.LANCZOS  # default interpolation for PNG
fill_color = '#ffffff'  # BG color to strip alpha channel
_VERSION_ = '3.0'  # current program version

# Globals for multiprocessing
pool = None
lock = Lock()
count = 0  # successful conversion count
count_lowres = 0  # no-op count due to low resolution


def getres(res):
    '''Retrieve hres and vres as a tuple

    :param res: resolution in hresxvres format
    '''
    try:
        hxv = res.split('x')
        assert len(hxv) == 2
        return map(int, hxv)
    except Exception:
        return (0, 0)


def gamma_aware_resize(img, isize, resample):
    '''Resize image with gamma correction for better quality

    Converts to linear color space before resizing, then converts back.
    This prevents the common error of resizing in gamma-corrected space.

    Fixes issue #60: https://github.com/jarun/imgp/issues/60
    See also: http://www.ericbrasseur.org/gamma.html

    :param img: PIL Image object
    :param isize: tuple of (width, height) for target size
    :param resample: resampling filter to use
    :return: resized PIL Image object
    '''
    # For images without color (e.g., 'L', '1'), no gamma correction needed
    if img.mode in ('L', '1', 'P'):
        return img.resize(isize, resample)

    # Handle alpha channel separately if present
    has_alpha = img.mode in ('RGBA', 'LA')
    if has_alpha:
        # Split into color and alpha
        if img.mode == 'RGBA':
            r, g, b, a = img.split()
            rgb_img = Image.merge('RGB', (r, g, b))
        else:  # LA
            l, a = img.split()
            rgb_img = Image.merge('RGB', (l, l, l))

        # Resize alpha separately (no gamma correction needed for alpha)
        resized_alpha = a.resize(isize, resample)
    else:
        rgb_img = img.convert('RGB') if img.mode != 'RGB' else img

    # Apply gamma correction: convert from sRGB to linear
    # Using simplified sRGB gamma of 2.2 (actual sRGB is more complex but 2.2 is close)
    gamma = 2.2
    linear_img = rgb_img.point(lambda x: pow(x / 255.0, gamma) * 255.0)

    # Resize in linear space
    resized_linear = linear_img.resize(isize, resample)

    # Convert back to sRGB: apply inverse gamma
    inv_gamma = 1.0 / gamma
    resized_rgb = resized_linear.point(lambda x: pow(x / 255.0, inv_gamma) * 255.0)

    # Reattach alpha if it was present
    if has_alpha:
        if img.mode == 'RGBA':
            r, g, b = resized_rgb.split()
            result = Image.merge('RGBA', (r, g, b, resized_alpha))
        else:  # LA - 8-bit pixels, grayscale with alpha
            result = Image.merge('LA', (resized_rgb.split()[0], resized_alpha))
        return result

    if img.mode != 'RGB':
        # Convert back to original mode if needed
        return resized_rgb.convert(img.mode)

    return resized_rgb


def lock_print(msg):
    '''Acquire lock and print a message'''

    with lock:
        print(msg)


# ---------------------------------------------------------------------------
# Processing pipeline stages
#
# read -> normalize orientation -> geometry -> resample -> write back
#
# Each stage is a separately testable unit. The order is significant:
# EXIF orientation must be baked into the pixels (exactly once) before
# the target geometry is computed, because orientations 5-8 swap width
# and height; the ICC profile and remaining EXIF tags travel in the
# ImageMeta object and are written back atomically at the end.
# ---------------------------------------------------------------------------

ORIENTATION_TAG = 0x0112  # EXIF orientation tag

# compute_target_size() decisions
SKIP = 'skip'              # do not write an output file
LOWRES = 'lowres'          # do not write; count as a low-resolution no-op
PASSTHROUGH = 'passthrough'  # write output without resampling
RESIZE = 'resize'          # resample to the attached (hres, vres)


class ImageMeta:
    '''Metadata carried through the pipeline alongside the pixels'''

    __slots__ = ('format', 'exif', 'icc_profile', 'progressive')

    def __init__(self):
        self.format = None
        self.exif = b''
        self.icc_profile = None
        self.progressive = False


def load_image(src):
    '''Stage 1: read an image and its metadata

    :return: (PIL.Image, ImageMeta) or None if the file is not processable
    '''

    try:
        img = Image.open(src)
        meta = ImageMeta()
        meta.format = img.format

        if meta.format not in ['JPEG', 'PNG', 'MPO', 'WEBP']:
            if debug:
                lock_print(src + ': not JPEG/PNG/MPO/WEBP. format: ' + str(meta.format))
            return None

        meta.progressive = progressive
        try:
            if meta.format == 'JPEG' and not meta.progressive and img.info['progressive']:
                if debug:
                    lock_print('load_image: progressive')
                meta.progressive = True
        except Exception:
            pass

        try:
            if not eraseexif:
                meta.exif = img.info['exif']
        except Exception:
            pass

        # the ICC profile is colour (not EXIF) metadata: always keep it
        meta.icc_profile = img.info.get('icc_profile')

        ImageFile.MAXBLOCK = img.size[0] * img.size[1]
        return img, meta
    except OSError as e:
        if not str(e).startswith('cannot identify image file'):
            lock_print(e)
        return None


def normalize_orientation(img, meta):
    '''Stage 2: bake the EXIF orientation into the pixels

    The rotation/flip implied by the EXIF orientation tag is applied to
    the pixel data exactly once, here, before any resampling, and the tag
    is removed from the EXIF payload so viewers do not rotate the output
    a second time. Must run before compute_target_size(): orientations
    5-8 swap width and height.
    '''

    exif = img.getexif()
    if exif.get(ORIENTATION_TAG, 1) == 1:
        return img

    img = ImageOps.exif_transpose(img)
    if meta.exif and ORIENTATION_TAG in exif:
        del exif[ORIENTATION_TAG]
        meta.exif = exif.tobytes() if len(exif) else b''
    return img


def _round_half_up(x):
    '''Round a float to the nearest int, halves rounded up'''

    i = int(x)
    return i + 1 if x >= i + .5 else i


def compute_target_size(hres, vres, fmt):
    '''Stage 3a: decide the output geometry (no pixel work)

    :param hres: current (orientation-normalized) horizontal resolution
    :param vres: current (orientation-normalized) vertical resolution
    :param fmt: image format ('JPEG', 'PNG', 'MPO' or 'WEBP')
    :return: (decision, value) where decision is one of SKIP, LOWRES,
             PASSTHROUGH, RESIZE; value is the target (hres, vres) for
             RESIZE, the failing dimension name for LOWRES, else None
    '''

    if hres < minH or vres < minV:
        if debug:
            lock_print('compute_target_size: hres < minH or vres < minV')
        return (SKIP, None)

    if keep and (HRES == hres or VRES == vres or scale == 100):
        if progressive and fmt not in ['JPEG', 'MPO']:
            return (SKIP, None)

        if convert and fmt not in ['PNG', 'WEBP']:
            return (SKIP, None)

        return (PASSTHROUGH, None)

    if megapixel:
        img_mp = hres * vres / 1e6

        shrink_factor = math.sqrt(megapixel / img_mp)
        if shrink_factor >= 1 and not enlarge:
            return (SKIP, None)

        _hres = round(hres * shrink_factor)
        _vres = round(vres * shrink_factor)

        if debug:
            lock_print(f"{img_mp} * {shrink_factor} → {_hres}x{_vres} ({_hres*_vres/1e6}MP)")

        return (RESIZE, (_hres, _vres))

    if scale:
        if scale == 100:
            return (RESIZE, (hres, vres))

        return (RESIZE, (_round_half_up(hres * scale/float(100)),
                         _round_half_up(vres * scale/float(100))))

    if HRES == 0 or VRES == 0:
        if HRES:
            if not enlarge and HRES > hres:
                return (LOWRES, 'hres')

            return (RESIZE, (HRES, _round_half_up(vres * HRES/float(hres))))

        # VRES is non-zero here (HRES and VRES cannot both be 0)
        if not enlarge and VRES > vres:
            return (LOWRES, 'vres')

        return (RESIZE, (_round_half_up(hres * VRES/float(vres)), VRES))

    if HRES == hres and VRES == vres:
        if debug:
            lock_print('compute_target_size: same res [%dx%d]' % (HRES, VRES))
        return (PASSTHROUGH, None)

    if force:
        return (RESIZE, (HRES, VRES))

    if adapt:
        ratio_img = float(hres/vres)
        ratio_target = float(HRES/VRES)

        if (ratio_target >= 1 and ratio_img > 1) or (ratio_target < 1 and ratio_img >= 1):
            # same orientation (H >= V and h > v) or
            # cross orientation (H < V and h >= v)
            if not enlarge and HRES > hres:
                return (LOWRES, 'hres')

            if HRES != hres:
                return (RESIZE, (HRES, _round_half_up(vres * HRES/float(hres))))
        elif (ratio_target < 1 and ratio_img < 1) or (ratio_target >= 1 and ratio_img <= 1):
            # same orientation (H < V and h < v) or
            # cross orientation (H >= V and h <= v)
            if not enlarge and VRES > vres:
                return (LOWRES, 'vres')

            if VRES != vres:
                return (RESIZE, (_round_half_up(hres * VRES/float(vres)), VRES))

        return (PASSTHROUGH, None)

    ratio_img = float(hres/vres)
    ratio_target = float(HRES/VRES)

    if ratio_img >= ratio_target:
        if not enlarge and HRES > hres:
            return (LOWRES, 'hres')

        # re-sample as per target horizontal resolution
        return (RESIZE, (HRES, _round_half_up(vres * HRES/float(hres))))

    if not enlarge and VRES > vres:
        return (LOWRES, 'vres')

    # re-sample as per target vertical resolution
    return (RESIZE, (_round_half_up(hres * VRES/float(vres)), VRES))


def flatten_for_jpeg(img):
    '''Stage 3b: strip the alpha channel for JPEG output'''

    if img.mode in ('RGBA', 'LA'):
        background = Image.new(img.mode.rstrip('A'), img.size, fill_color)
        background.paste(img, img.split()[-1])
        return background
    if img.mode == 'P':
        return img.convert('RGB')
    return img


def output_dest(name, ext, fmt):
    '''Stage 4a: destination path and output format (applies --convert)

    :return: (dest path, output format, converted?)
    '''

    suffix = '' if overwrite else pad
    if convert and fmt in ['PNG', 'WEBP']:
        return name + suffix + '.jpg', 'JPEG', True
    return name + suffix + ext, fmt, False


def save_image(img, dest, fmt, meta):
    '''Stage 4b: write img to dest atomically, preserving metadata

    The image is encoded to a temp file in the same directory and moved
    over dest with os.replace(), so a failed encode never leaves a
    partially written image behind.

    :return: True on success, False on failure (dest left untouched)
    '''

    tmp = '%s.imgp%d.tmp' % (dest, os.getpid())
    try:
        img.save(tmp, fmt, quality=qual, optimize=optimal, exif=meta.exif,
                 icc_profile=meta.icc_profile, progressive=meta.progressive)
        os.replace(tmp, dest)
        return True
    except OSError as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        lock_print(e)
        return False


# Settings workers read; spawn/forkserver workers don't inherit main()'s globals
WORKER_VARS = ('HRES', 'VRES', 'megapixel', 'scale', 'rotate', 'adapt', 'convert',
               'hidden', 'eraseexif', 'force', 'includeimgp', 'keep', 'enlarge',
               'optimal', 'progressive', 'mute', 'recurse', 'size', 'qual',
               'overwrite', 'debug', 'no_res_opt', 'png_ip', 'minH', 'minV')


def init_worker(shared_lock, state):
    '''Pool initializer: apply parent settings in the worker process'''

    global lock
    lock = shared_lock
    globals().update(state)


def cb(data):
    global count, count_lowres

    if data:
        count += data[0]
        count_lowres += data[1]


def traverse_dir(path):
    '''Traverse a directory recursively'''

    try:
        for entry in os.scandir(path):
            # Add check for hidden here
            if not hidden and entry.name.startswith('.'):
                continue

            if entry.is_dir(follow_symlinks=False):
                if recurse:
                    if not os.access(entry.path, os.W_OK | os.X_OK):
                        lock_print(entry.path + ': no permission')
                        continue
                    traverse_dir(entry.path)
            elif (entry.is_file(follow_symlinks=False) and
                  entry.stat().st_size >= size):
                if rotate is not None:
                    pool.apply_async(rotate_image, args=(entry.path,), callback=cb)
                else:
                    pool.apply_async(resize_image, args=(entry.path,), callback=cb)
    except OSError as e:
        lock_print(e)


def rotate_image(src):
    '''Rotate a source image'''

    name, ext = os.path.splitext(src)
    if name.endswith(pad) and not includeimgp:
        return

    loaded = load_image(src)
    if loaded is None:
        return
    img, meta = loaded

    # normalize EXIF orientation before rotating so the rotation is
    # applied on the pixels the user actually sees
    # Image.rotate(angle, resample=0, expand=0) expand = True means
    # the image will be enlarged to hold the entire rotated image
    try:
        img = normalize_orientation(img, meta)
        img = img.rotate(-rotate, 0, True)
    except OSError as e:
        img.close()
        lock_print(e)
        return

    if not mute:
        stats = src + '\n%ld bytes ->' % os.path.getsize(src)

    dest, out_format, converted = output_dest(name, ext, meta.format)
    if converted:
        img = flatten_for_jpeg(img)

    if save_image(img, dest, out_format, meta):
        if not mute:
            lock_print('%s %ld bytes\n' % (stats, os.path.getsize(dest)))

        if overwrite and converted:
            os.remove(src)

        return [1, 0]


def resize_image(src):
    '''Resize a source image'''

    name, ext = os.path.splitext(src)
    if name.endswith(pad) and not includeimgp:
        return

    loaded = load_image(src)
    if loaded is None:
        return
    img, meta = loaded

    # check if convert or progressive is specified without any resolution option
    if no_res_opt:
        if convert and meta.format not in ['PNG', 'WEBP']:
            if debug:
                lock_print('resize_image: cannot convert non-PNG/WEBP')
            return

        if progressive and meta.format not in ['JPEG', 'MPO']:
            if debug:
                lock_print('resize_image: cannot make non-JPEG/MPO progressive')
            return

    # bake EXIF orientation into the pixels before measuring/resampling
    try:
        img = normalize_orientation(img, meta)
        hres, vres = img.size

        antialias = png_ip if meta.format == 'PNG' else Image.Resampling.LANCZOS

        decision, value = compute_target_size(hres, vres, meta.format)
        if decision == RESIZE:
            img = gamma_aware_resize(img, value, antialias)
            if debug:
                lock_print('resize_image: scaled to [%dx%d]' % value)
    except OSError as e:
        # e.g. truncated source: fail without touching the destination
        img.close()
        lock_print(e)
        return

    if decision == SKIP:
        return
    if decision == LOWRES:
        if not mute:
            lock_print('%s has lesser %s\n' % (src, value))
        return [0, 1]

    if not mute:
        stats = src + '\n%dx%d -> %dx%d\n%ld bytes ->' % (hres, vres, img.size[0], img.size[1], os.path.getsize(src))

    dest, out_format, converted = output_dest(name, ext, meta.format)
    if converted:
        img = flatten_for_jpeg(img)

    if save_image(img, dest, out_format, meta):
        if not mute:
            lock_print('%s %ld bytes\n' % (stats, os.path.getsize(dest)))

        if overwrite and converted:
            os.remove(src)

        return [1, 0]


class ExtendedArgumentParser(argparse.ArgumentParser):
    '''Extend classic argument parser'''

    # Print additional help and info
    @staticmethod
    def print_extended_help(file=None):
        if not file:
            file = sys.stderr

        file.write('''
Version %s
Copyright © 2016-2026 Arun Prakash Jana <engineerarun@gmail.com>
License: GPL-3.0-or-later
Webpage: https://github.com/jarun/imgp
''' % _VERSION_)

    # Help
    def print_help(self, file=None):
        super().print_help(file)
        self.print_extended_help(file)


def parse_args(args=None, namespace=None):
    '''Parse imgp arguments/options.
    Parameters
    ----------
    args : list, optional
        Arguments to parse. Default is ``sys.argv``.
    namespace : argparse.Namespace
        Namespace to write to. Default is a new namespace.
    Returns
    -------
    argparse.Namespace
        Namespace with parsed arguments / options.
    '''

    argparser = ExtendedArgumentParser(description='Resize, rotate JPEG, PNG and WEBP images.',
                                       formatter_class=argparse.RawTextHelpFormatter)
    addarg = argparser.add_argument
    addarg('-x', '--res', nargs=1, metavar='res',
           help='output resolution in HxV or percentage ("%%" suffix) or megapixel ("MP" suffix)')
    addarg('-o', '--rotate', type=int, metavar='deg',
           help='rotate clockwise by angle (in degrees)')
    addarg('-a', '--adapt', action='store_true',
           help='adapt to resolution by orientation [default: off]')
    addarg('-c', '--convert', action='store_true',
           help='convert PNG/WEBP to JPG format [default: off]')
    addarg('-e', '--eraseexif', action='store_true',
           help='erase exif metadata [default: off]')
    addarg('-f', '--force', action='store_true',
           help='force to exact specified resolution [default: off]')
    addarg('-H', '--hidden', action='store_true',
           help='include hidden (dot) files [default: off]')
    addarg('-i', '--includeimgp', action='store_true',
           help='re-process _IMGP files. * RISKY: refer to docs')
    addarg('-k', '--keep', action='store_true',
           help=textwrap.dedent('''\
                skip (honors -c or --pr) images matching specified
                H or V or --res=100 [default: off]'''))
    addarg('-m', '--mute', action='store_true',
           help='operate silently [default: informative]')
    addarg('-M', '--minres', nargs=1, metavar='res',
           help='min resolution in HxV or percentage of --res to resize')
    addarg('-n', '--enlarge', action='store_true',
           help='enlarge smaller images [default: off]')
    addarg('-N', '--nearest', action='store_true',
           help='use nearest neighbour interpolation for PNG [default: antialias]')
    addarg('-O', '--optimize', action='store_true',
           help='optimize the output images [default: off]')
    addarg('-P', '--progressive', action='store_true',
           help='save JPEG images as progressive [default: off]')
    addarg('-q', '--quality', type=int, metavar='N', choices=range(1, 96),
           help=f'quality factor (N=1-95, JPEG only) [default: {qual}]')
    addarg('-r', '--recurse', action='store_true',
           help='process non-symbolic dirs recursively [default: off]')
    addarg('-s', '--size', type=int, metavar='byte',
           help=f'minimum size to process an image [default: {size}]')
    addarg('-w', '--overwrite', action='store_true',
           help='overwrite source images [default: off]')
    addarg('-d', '--debug', action='store_true',
           help='enable debug logs [default: off]')
    addarg('-v', '--version', action='version', version=_VERSION_)
    addarg('keywords', nargs='*', metavar='PATH',
           help='source file or dir [default: current dir]')

    # Show help and exit if no arguments
    if len(sys.argv) < 2:
        argparser.print_help(sys.stderr)
        sys.exit(1)

    return argparser.parse_args(args, namespace)


def main():
    global HRES, VRES, megapixel, scale, rotate, adapt, convert, hidden, eraseexif, force, \
           includeimgp, keep, enlarge, optimal, progressive, mute, recurse, size, \
           qual, overwrite, debug, no_res_opt, pool, count, png_ip, minH, minV

    init_time = time.time()  # profile the total time taken
    args = parse_args()

    if args.rotate is not None and args.res is not None:
        print('options --rotate and --res cannot be used together')
        return

    if args.res is not None:
        if 'x' in args.res[0]:
            HRES, VRES = getres(args.res[0])
            if HRES == 0 and VRES == 0:
                print('-ve values not allowed in --res, '
                      'hres and vres cannot be 0 together')
                return
        elif args.res[0].upper().endswith("MP"):
            try:
                megapixel = float(args.res[0].upper().rstrip("MP"))
            except ValueError:
                print(f'failed parsing megapixel value from "{args.res[0]}"')
                return
        else:
            try:
                scale = int(args.res[0].rstrip("%"))

                if scale <= 0:
                    print('scale should be > 0%')
                    return
                if scale > 100 and not args.enlarge:
                    print('use --enlarge to scale > 100%')
                    return
            except ValueError:
                print(f'invalid value for --res: "{args.res[0]}"')
                return
    elif args.rotate is not None:
        rotate = args.rotate % 360
        if not rotate:
            print('cannot rotate by 0 degree')
            return
    elif args.convert or args.progressive or args.optimize:
        no_res_opt = True
        scale = 100
    else:
        print('missing image transformation')
        return

    if args.minres is not None:
        if 'x' in args.minres[0]:
            minH, minV = getres(args.minres[0])
            if minH == 0 or minV == 0:
                print('-ve values not allowed in --minres, '
                      'H or V cannot be 0')
                return
        else:
            if scale is not None:
                print('both --res and --minres cannot be in percentage')
                return

            try:
                minscale = int(args.minres[0].rstrip('%'))

                if minscale <= 0:
                    print('--minres should be > 0%')
                    return

                minH = (HRES * minscale) / 100
                minV = (VRES * minscale) / 100
            except Exception:
                print('invalid value for --minres')
                return

    adapt = args.adapt
    convert = args.convert
    hidden = args.hidden
    eraseexif = args.eraseexif
    force = args.force
    includeimgp = args.includeimgp
    keep = args.keep
    enlarge = args.enlarge
    optimal = args.optimize
    progressive = args.progressive
    mute = args.mute
    recurse = args.recurse
    if args.size is not None:
        size = args.size
    if args.quality is not None:
        qual = args.quality
    overwrite = args.overwrite
    debug = args.debug
    if args.nearest:
        png_ip = PIL.Image.Resampling.NEAREST

    state = {name: globals()[name] for name in WORKER_VARS}
    pool = Pool(initializer=init_worker, initargs=(lock, state))

    for path in args.keywords:
        if not os.path.exists(path):
            print('%s does not exist' % path)
        elif os.path.isdir(path):
            traverse_dir(path)
        elif args.rotate is not None:
            if rotate_image(path):
                count += 1
        else:
            if resize_image(path):
                count += 1

    # Process current directory if PATH is unspecified
    if len(args.keywords) == 0:
        if not mute:
            print('Source omitted. Processing current directory...\n')
        traverse_dir('.')

    pool.close()
    pool.join()

    if not mute:
        # Show number of images converted
        if count:
            print('%s images processed in %.4f seconds.' % (count, time.time() - init_time))

        # Show number of images not converted due to low resolution
        if count_lowres:
            print('%s not processed due to low resolution.' % count_lowres)


if __name__ == '__main__':
    main()
